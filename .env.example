# Copy to .env and fill in real values before running docker compose up
POSTGRES_DB=atom
POSTGRES_USER=atom
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_PORT=5432

JWT_SECRET=change-me-at-least-32-characters-long-secret
BACKEND_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000

AI_SERVICE_PORT=8000
FRONTEND_PORT=3000

# AI service LLM provider (any OpenAI-compatible API).
# Leave LLM_API_KEY empty to use the built-in rule-based toxicity screening.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30
LLM_MAX_ATTEMPTS=3

# Backend AI client tuning (retries when AI service is unreachable)
AI_MAX_ATTEMPTS=2
AI_RETRY_BACKOFF_MS=1500

# Optional initial admin (password min 12 chars)
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=
